PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/emailscheduler?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200

# Auth & Sessions
JWT_SECRET=super-secret-jwt-key-change-in-production
SESSION_COOKIE_NAME=email_scheduler_token

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# Slack OAuth (incoming-webhook)
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:5001/api/slack/callback

# Rate Limiting & Concurrency
MAX_EMAILS_PER_HOUR_PER_SENDER=100
MIN_DELAY_PER_SENDER_MS=2000
WORKER_CONCURRENCY=5

# Bull Board Dashboard
ADMIN_PASSWORD=adminsecret
